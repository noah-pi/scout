{
  "manifest_version": 3,
  "name": "Scout",
  "version": "0.3.0",
  "description": "Quiet until it matters: trackers, scams, bots and provenance, explained.",
  "key": "",
  "minimum_chrome_version": "138",
  "permissions": [
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "offscreen",
    "privacy",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gpc",
        "enabled": true,
        "path": "rules/gpc.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rules/easyprivacy.json"
      },
      {
        "id": "easyprivacy-allow",
        "enabled": true,
        "path": "rules/easyprivacy-allow.json"
      },
      {
        "id": "easylist",
        "enabled": true,
        "path": "rules/easylist.json"
      },
      {
        "id": "easylist-allow",
        "enabled": true,
        "path": "rules/easylist-allow.json"
      },
      {
        "id": "clean-urls",
        "enabled": true,
        "path": "rules/clean-urls.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/consent.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/spoilers.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "dist/reddit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.co.jp/search*",
        "*://www.google.com.br/search*",
        "*://www.bing.com/search*",
        "*://www.bing.com/images/*",
        "*://duckduckgo.com/*",
        "*://search.brave.com/*",
        "*://www.startpage.com/*"
      ],
      "js": [
        "dist/slop.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "action": {
    "default_title": "Scout"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
